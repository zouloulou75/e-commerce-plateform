@model GadgetStore.Models.Category

@{
    ViewData["Title"] = "Créer une catégorie";
}

<div class="container py-5" style="max-width: 720px;">
    <!-- Header avec bouton retour -->
    <div class="d-flex align-items-center gap-4 mb-5">
        <a href="/Admin/Categories" class="text-decoration-none">
            <span class="material-icons" style="font-size:42px; color:#0d6efd;">arrow_back_ios_new</span>
        </a>
        <div>
            <h1 class="display-6 fw-bold mb-1 d-flex align-items-center gap-3">
                <span class="material-icons" style="font-size:48px; color:#0d6efd;">add_circle</span>
                Creer une nouvelle categorie
            </h1>
            <p class="text-muted mb-0">Ajoutez une categorie a votre boutique</p>
        </div>
    </div>

    <!-- Card bleu bébé -->
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-header text-white text-center py-4"
             style="background:linear-gradient(135deg, #0d6efd 0%, #4d94ff 100%);">
            <h4 class="mb-0 fw-bold d-flex align-items-center justify-content-center gap-3">
                <span class="material-icons" style="font-size:32px;">create_new_folder</span>
                Nouvelle categorie
            </h4>
        </div>

        <div class="card-body p-5">

            <!-- Message d'erreur TempData -->
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger border-0 rounded-3 shadow-sm d-flex align-items-center gap-3 mb-4"
                     style="background:#ffe5e5;">
                    <span class="material-icons text-danger">error_outline</span>
                    <div>
                        <strong>Attention !</strong> @TempData["ErrorMessage"]
                    </div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }

            <form asp-action="CreateCategory" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-semibold" style="color:#0d6efd;">
                        Nom de la categorie
                    </label>

                    <div class="position-relative">
                        <span class="material-icons position-absolute top-50 start-4 translate-middle-y"
                              style="color:#0d6efd; font-size:24px;">
                            tag
                        </span>
                        <input asp-for="Name"
                               class="form-control form-control-lg rounded-pill ps-5 shadow-sm"
                               placeholder="Ex: Smartphones, Ordinateurs, Accessoires..."
                               style="border:2px solid #a8d0ff; height:58px; font-size:1.1rem;" />
                    </div>

                    <span asp-validation-for="Name" class="text-danger small mt-1"></span>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-5">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                        Annuler
                    </a>
                    <button type="submit"
                            class="btn text-white px-5 py-2 rounded-pill shadow-sm d-flex align-items-center gap-2"
                            style="background:#0d6efd; border:none; font-weight:500; box-shadow:0 8px 25px rgba(13,110,253,0.25);">
                        <span class="material-icons">check_circle</span>
                        Creer 
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- CDNs (une seule fois dans _Layout.cshtml idéalement) -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" />
<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons" />

<style>
    body {
        font-family: 'Roboto', sans-serif;
        background: #f8f9ff;
    }

    .card {
        box-shadow: 0 12px 35px rgba(13,110,253,0.12) !important;
    }

    .form-control:focus {
        border-color: #0d6efd !important;
        box-shadow: 0 0 0 0.25rem rgba(13,110,253,0.2) !important;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}