@model GadgetStore.Models.Category

@{
    ViewData["Title"] = "Modifier la catégorie";
}

<div class="container mt-5" style="max-width: 720px;">
    <!-- Header avec retour -->
    <div class="d-flex align-items-center gap-4 mb-5">
        <a href="/Admin/Categories" class="text-decoration-none">
            <span class="material-icons" style="font-size: 42px; color:#0d6efd;">arrow_back_ios_new</span>
        </a>
        <div>
            <h1 class="display-6 fw-bold mb-1 d-flex align-items-center gap-3">
                <span class="material-icons" style="font-size: 48px; color:#0d6efd;">edit</span>
                Modifier la categorie
            </h1>
            <p class="text-muted mb-0">ID #@Model.Id</p>
        </div>
    </div>

    <!-- Card principale bleu bébé -->
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-header text-white text-center py-4"
             style="background: linear-gradient(135deg, #0d6efd 0%, #4d94ff 100%);">
            <h4 class="mb-0 fw-bold d-flex align-items-center justify-content-center gap-3">
                <span class="material-icons">folder_special</span>
                @Model.Name
            </h4>
        </div>

        <div class="card-body p-5">
            <form method="post" asp-action="Edit" asp-route-id="@Model.Id">
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-semibold" style="color:#0d6efd;"></label>

                    <div class="position-relative">


                        <input asp-for="Name"
                               class="form-control form-control-lg rounded-pill ps-5 shadow-sm"
                               placeholder="Nom de la catégorie"
                               style="border: 2px solid #a8d0ff; height: 56px; font-size:1.1rem;" />
                    </div>

                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-5">
                    <a href="/Admin/Categories" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                        Annuler
                    </a>
                    <button type="submit"
                            class="btn btn-primary px-5 py-2 rounded-pill shadow-sm d-flex align-items-center gap-2"
                            style="background:#0d6efd; border:none; font-weight:500;">
                        <span class="material-icons">check_circle</span>
                        Mettre a jour
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- CDNs (à mettre une seule fois dans _Layout.cshtml si ce n’est pas déjà fait) -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" />
<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons" />

<style>
    body {
        font-family: 'Roboto', sans-serif;
        background: #f8f9ff;
    }

    .card {
        box-shadow: 0 12px 35px rgba(13, 110, 253, 0.12) !important;
    }

    .form-control:focus {
        border-color: #0d6efd !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15) !important;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}