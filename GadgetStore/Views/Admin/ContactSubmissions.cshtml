@model IEnumerable<GadgetStore.Models.ContactUs>

@{
    ViewData["Title"] = "Contact Submissions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-vh-100 bg-gray-50">
    <div class="container py-5" style="max-width: 1400px;">

        <!-- Header -->
        <div class="d-flex align-items-center justify-content-between mb-5">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1">Contact Submissions</h1>
                <p class="text-muted mb-0">All messages received from the contact form</p>
            </div>
            <div class="text-end">
                <span class="fs-4 fw-bold text-primary">@Model.Count()</span>
                <small class="text-muted d-block">total messages</small>
            </div>
        </div>

        <!-- Search Bar -->
        <div class="bg-white rounded-3 shadow-sm p-4 mb-4">
            <div class="position-relative">
                <span class="material-icons position-absolute top-50 start-4 translate-middle-y text-muted">search</span>
                <input type="text" id="searchInput" class="form-control form-control-lg rounded-pill ps-5 border-0"
                       placeholder="Search by name, email or subject..." autocomplete="off">
            </div>
        </div>

        <!-- Submissions Table -->
        <div class="bg-white rounded-4 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="submissionsTable">
                    <thead class="bg-light text-secondary small text-uppercase fw-semibold">
                        <tr>
                            <th class="ps-4 py-3">Sender</th>
                            <th class="py-3">Email</th>
                            <th class="py-3">Subject</th>
                            <th class="py-3">Message</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <span class="material-icons" style="font-size:64px;opacity:0.3;">mail_outline</span>
                                    <p class="mt-3 fs-5">No messages received yet</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr class="border-bottom">
                                    <td class="ps-4 py-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center text-white fw-bold"
                                                 style="width:48px;height:48px;font-size:20px;">
                                                @(string.IsNullOrEmpty(item.Name) ? "?" : item.Name.Trim().Split(' ').Select(n => n[0]).Take(2).Aggregate("", (s, c) => s + char.ToUpper(c)))
                                            </div>
                                            <div>
                                                <div class="fw-semibold text-dark">@item.Name</div>
                                                <small class="text-muted">Customer</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <a href="mailto:@item.Email" class="text-primary text-decoration-none fw-medium">
                                            @item.Email
                                        </a>
                                    </td>
                                    <td class="fw-medium">
                                        @(string.IsNullOrEmpty(item.Subject) ? "<em>No subject</em>" : item.Subject)
                                    </td>
                                    <td class="text-muted" style="max-width:400px;">
                                        <div class="text-truncate" title="@item.Message">
                                            @item.Message
                                        </div>
                                    </td>
                             
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Footer -->
        <div class="text-center mt-5">
            <p class="text-muted">
                Total messages received: <strong class="text-primary fs-4">@Model.Count()</strong>
            </p>
        </div>
    </div>
</div>

<!-- Fonts & Icons -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons" />

<style>
    body {
        font-family: 'Inter', sans-serif;
        background: #f9fafb;
    }

    .bg-gray-50 {
        background: #f9fafb;
    }

    .table tr:hover {
        background: #f8f9ff !important;
    }

    .btn {
        transition: all 0.2s;
    }

        .btn:hover {
            transform: translateY(-2px);
        }

    .form-control:focus {
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
        border-color: #0d6efd;
    }

    [title]:hover {
        cursor: help;
    }
</style>

<script>
    // Live search
    document.getElementById('searchInput').addEventListener('keyup', function () {
        const term = this.value.toLowerCase();
        document.querySelectorAll('#submissionsTable tbody tr').forEach(row => {
            const text = row.textContent.toLowerCase();
            row.style.display = text.includes(term) ? '' : 'none';
        });
    });
</script>