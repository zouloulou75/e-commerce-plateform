@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-vh-100 bg-gray-50">
    <div class="container py-5" style="max-width: 1300px;">

        <!-- Header -->
        <div class="text-center mb-5">
            <h1 class="display-5 fw-bold text-primary mb-3">Welcome to Admin Dashboard</h1>
            <p class="text-muted fs-5">Manage your store with ease and efficiency.</p>
        </div>

        <!-- Cards Grid -->
        <div class="row g-4 justify-content-center">

            <div class="col-lg-4 col-md-6">
                <a href="/Admin/Categories" class="text-decoration-none">
                    <div class="bg-white rounded-4 shadow-sm p-5 text-center hover-lift h-100 border-start border-5 border-primary">
                        <span class="material-icons text-primary mb-3" style="font-size:60px;">category</span>
                        <h4 class="fw-bold text-dark mb-2">Categories</h4>
                        <p class="text-muted mb-0">Manage product categories</p>
                    </div>
                </a>
            </div>

            <div class="col-lg-4 col-md-6">
                <a href="/Admin/Products" class="text-decoration-none">
                    <div class="bg-white rounded-4 shadow-sm p-5 text-center hover-lift h-100 border-start border-5 border-success">
                        <span class="material-icons text-success mb-3" style="font-size:60px;">inventory_2</span>
                        <h4 class="fw-bold text-dark mb-2">Products</h4>
                        <p class="text-muted mb-0">Manage your products</p>
                    </div>
                </a>
            </div>

            <div class="col-lg-4 col-md-6">
                <a href="/Admin/Orders" class="text-decoration-none">
                    <div class="bg-white rounded-4 shadow-sm p-5 text-center hover-lift h-100 border-start border-5 border-info">
                        <span class="material-icons text-info mb-3" style="font-size:60px;">shopping_cart</span>
                        <h4 class="fw-bold text-dark mb-2">Orders</h4>
                        <p class="text-muted mb-0">Manage all the orders</p>
                    </div>
                </a>
            </div>

            <div class="col-lg-4 col-md-6">
                <a href="/Admin/ContactSubmissions" class="text-decoration-none">
                    <div class="bg-white rounded-4 shadow-sm p-5 text-center hover-lift h-100 border-start border-5 border-warning">
                        <span class="material-icons text-warning mb-3" style="font-size:60px;">mail_outline</span>
                        <h4 class="fw-bold text-dark mb-2">Inquiries</h4>
                        <p class="text-muted mb-0">View all contact messages</p>
                    </div>
                </a>
            </div>

            <div class="col-lg-4 col-md-6">
                <a href="/Admin/Customers" class="text-decoration-none">
                    <div class="bg-white rounded-4 shadow-sm p-5 text-center hover-lift h-100 border-start border-5 border-danger">
                        <span class="material-icons text-danger mb-3" style="font-size:60px;">people_alt</span>
                        <h4 class="fw-bold text-dark mb-2">Customers</h4>
                        <p class="text-muted mb-0">Manage registered users</p>
                    </div>
                </a>
            </div>

        </div>

        <!-- Footer note -->
        <div class="text-center mt-5">
            <p class="text-muted small">
                © @DateTime.Now.Year GadgetStore — Admin Panel
            </p>
        </div>
    </div>
</div>

<!-- Fonts & Icons -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons" />

<style>
    body {
        font-family: 'Inter', sans-serif;
        background: #f9fafb;
    }

    .bg-gray-50 {
        background: #f9fafb;
    }

    .hover-lift {
        transition: all 0.3s ease;
    }

        .hover-lift:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.1) !important;
        }

    .border-start {
        border-left-width: 6px !important;
    }
</style>