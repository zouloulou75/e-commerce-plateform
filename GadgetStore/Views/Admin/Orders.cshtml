@model IEnumerable<GadgetStore.Models.Order>

@{
    ViewData["Title"] = "Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-vh-100 bg-gray-50">
    <div class="container py-5" style="max-width: 1400px;">

        <!-- Header -->
        <div class="d-flex align-items-center justify-content-between mb-5">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1">Orders</h1>
                <p class="text-muted mb-0">Manage all customer orders</p>
            </div>
            <div class="text-end">
                <span class="fs-4 fw-bold text-primary">@Model.Count()</span>
                <small class="text-muted d-block">total orders</small>
            </div>
            <!-- Add this inside the header section, next to the search bar or title -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <a asp-action="ExportToExcel" class="btn btn-success btn-lg rounded-pill shadow-sm">
                    <span class="material-icons me-2" style="font-size:20px;">download</span>
                    Export to Excel
                </a>
            </div>
        </div>

        <!-- Search Bar -->
        <div class="bg-white rounded-3 shadow-sm p-4 mb-4">
            <div class="position-relative">
                <span class="material-icons position-absolute top-50 start-4 translate-middle-y text-muted">search</span>
                <input type="text" id="searchInput" class="form-control form-control-lg rounded-pill ps-5 border-0"
                       placeholder="Search by name, email, phone or order ID..." autocomplete="off">
            </div>
        </div>

        <!-- Orders Table -->
        <div class="bg-white rounded-4 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="ordersTable">
                    <thead class="bg-light text-secondary small text-uppercase fw-semibold">
                        <tr>
                            <th class="ps-4 py-3">Order</th>
                            <th class="py-3">Customer</th>
                            <th class="py-3">Contact</th>
                            <th class="py-3">Items</th>
                            <th class="py-3">Total</th>
                            <th class="py-3">Date</th>
                            <th class="py-3">Payment</th>
                            <th class="text-end pe-4 py-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <span class="material-icons" style="font-size:64px;opacity:0.3;">receipt_long</span>
                                    <p class="mt-3 fs-5">No orders found</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var order in Model)
                            {
                                var totalItems = order.OrderItems?.Sum(i => i.Quantity) ?? 0;
                                <tr class="border-bottom">
                                    <td class="ps-4 py-4">
                                        <div class="fw-bold text-primary">#@order.Id</div>
                                        <small class="text-muted">ID</small>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@order.CustomerName</div>
                                    </td>
                                    <td>
                                        <div class="text-muted small">@order.Email</div>
                                        <div class="text-muted small">@order.Phone</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark rounded-pill px-3 py-2 fw-medium">
                                            @totalItems item@(totalItems > 1 ? "s" : "")
                                        </span>
                                    </td>
                                    <td class="fw-bold text-success fs-5">@order.TotalAmount.ToString("C2")</td>
                                    <td>
                                        <div class="text-muted small">@order.OrderDate.ToString("MMM dd, yyyy")</div>
                                        <div class="text-muted small">@order.OrderDate.ToString("h:mm tt")</div>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill px-3 py-2 fw-medium
                                                     @(order.PaymentMethod.Contains("Card") ? "bg-success text-white" : "bg-info text-white")">
                                            @(order.PaymentMethod.Contains("Card") ? "Card" : "COD")
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a href="/Admin/Orders/Details/@order.Id"
                                           class="btn btn-sm btn-primary rounded-pill px-4 shadow-sm">
                                            <span class="material-icons me-1" style="font-size:18px;">visibility</span>
                                            View
                                        </a>
                                        <a href="/Admin/Orders/Invoice/@order.Id" class="btn btn-sm btn-danger rounded-pill px-3 ms-2">
                                            <span class="material-icons" style="font-size:16px;">picture_as_pdf</span>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Footer Stats -->
        <div class="text-center mt-5">
            <p class="text-muted">
                Showing <strong>@Model.Count()</strong> order@(Model.Count() != 1 ? "s" : "")
                @if (Model.Any())
                {
                    <span class="text-primary">• Total revenue: <strong>@Model.Sum(o => o.TotalAmount):C2</strong></span>
                }
            </p>
        </div>
    </div>
</div>

<!-- Fonts & Icons -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons" />

<style>
    body {
        font-family: 'Inter', sans-serif;
        background: #f9fafb;
    }

    .bg-gray-50 {
        background: #f9fafb;
    }

    .table tr:hover {
        background: #f8f9ff !important;
    }

    .btn {
        transition: all 0.2s;
    }

        .btn:hover {
            transform: translateY(-2px);
        }

    .form-control:focus {
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
        border-color: #0d6efd;
    }
</style>

<script>
    // Live search
    document.getElementById('searchInput').addEventListener('keyup', function () {
        const term = this.value.toLowerCase();
        document.querySelectorAll('#ordersTable tbody tr').forEach(row => {
            const text = row.textContent.toLowerCase();
            row.style.display = text.includes(term) ? '' : 'none';
        });
    });
</script>