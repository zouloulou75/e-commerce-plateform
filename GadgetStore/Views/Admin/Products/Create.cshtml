@model GadgetStore.Models.Product

@{
    ViewData["Title"] = "Add Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-vh-100 bg-gray-50">
    <div class="container py-5" style="max-width: 900px;">

        <!-- Header -->
        <div class="d-flex align-items-center justify-content-between mb-5">
            <div class="d-flex align-items-center gap-4">
                <a href="/Admin/Products" class="text-decoration-none">
                    <div class="bg-white rounded-circle p-2 shadow-sm">
                        <span class="material-icons text-primary" style="font-size: 24px;">arrow_back</span>
                    </div>
                </a>
                <div>
                    <h1 class="h4 fw-bold text-dark mb-1">Add New Product</h1>
                    <p class="text-muted mb-0 small">Fill in the details below</p>
                </div>
            </div>
            <a href="/Admin/Products" class="btn btn-sm btn-outline-secondary rounded-pill px-4">
                Cancel
            </a>
        </div>

        <!-- Form Card -->
        <div class="bg-white rounded-4 shadow-sm p-5">
            <form asp-action="CreateProduct" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-4">
                    <!-- Left: Fields -->
                    <div class="col-lg-7">

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-semibold">Product Name</label>
                            <input asp-for="Name" class="form-control form-control-lg rounded-3" placeholder="Enter product name" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold">Description <small class="text-muted">(optional)</small></label>
                            <textarea asp-for="Description" class="form-control rounded-3" rows="4" placeholder="Describe your product..."></textarea>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6 mb-4">
                                <label asp-for="Price" class="form-label fw-semibold">Price</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">$</span>
                                    <input asp-for="Price" class="form-control form-control-lg rounded-3" step="0.01" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="CategoryId" class="form-label fw-semibold">Category</label>
                                <select asp-for="CategoryId" class="form-select form-select-lg rounded-3"
                                        asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
                                    <option value="">Select category</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-5">
                            <label asp-for="ImageUrl" class="form-label fw-semibold">Image URL</label>
                            <input asp-for="ImageUrl" class="form-control form-control-lg rounded-3"
                                   placeholder="https://example.com/image.jpg" id="imageUrlInput" />
                            <small class="text-muted">Paste a direct link to an image (jpg, png, webp)</small>
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        </div>

                        <!-- Petits boutons élégants -->
                        <div class="d-flex gap-3 align-items-center">
                            <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4 shadow-sm">
                                <span class="material-icons me-1" style="font-size:18px;">add_circle</span>
                                Create Product
                            </button>
                            <a href="/Admin/Products" class="text-muted small text-decoration-none">
                                or cancel
                            </a>
                        </div>
                    </div>

                    <!-- Right: Live Preview -->
                    <div class="col-lg-5">
                        <div class="text-center">
                            <h6 class="text-muted mb-3 fw-semibold">Live Preview</h6>
                            <div class="border border-2 border-dashed rounded-4 p-4 bg-light" style="min-height: 360px;">
                                <div id="previewContainer" class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
                                    <span class="material-icons mb-3" style="font-size: 72px; opacity: 0.3;">image</span>
                                    <p class="mb-0 small">Paste an image URL to see preview</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Fonts & Icons -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons" />

<style>
    body {
        font-family: 'Inter', sans-serif;
        background: #f9fafb;
    }

    .bg-gray-50 {
        background: #f9fafb;
    }

    .form-control:focus, .form-select:focus {
        border-color: #0d6efd !important;
        box-shadow: 0 0 0 0.2rem rgba(13,110,253,.15) !important;
    }

    .btn {
        transition: all 0.2s;
    }

        .btn:hover {
            transform: translateY(-2px);
        }
</style>

<script>
    // Live image preview
    const input = document.getElementById('imageUrlInput');
    const container = document.getElementById('previewContainer');

    input.addEventListener('input', function () {
        const url = this.value.trim();
        if (url) {
            const img = document.createElement('img');
            img.src = url;
            img.className = "img-fluid rounded-3 shadow-sm";
            img.style.maxHeight = "320px";
            img.style.objectFit = "contain";

            img.onload = () => {
                container.innerHTML = '';
                container.appendChild(img);
            };
            img.onerror = () => {
                container.innerHTML = `
                    <span class="material-icons mb-3" style="font-size:72px;opacity:0.3;">broken_image</span>
                    <p class="small text-danger">Invalid image URL</p>
                `;
            };
        } else {
            container.innerHTML = `
                <span class="material-icons mb-3" style="font-size:72px;opacity:0.3;">image</span>
                <p class="mb-0 small">Paste an image URL to see preview</p>
            `;
        }
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}