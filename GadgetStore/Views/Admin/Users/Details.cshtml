@model Microsoft.AspNetCore.Identity.IdentityUser

@{
    ViewData["Title"] = "User Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-vh-100 bg-gray-50">
    <div class="container py-5" style="max-width: 1000px;">

        <!-- Header + Back Button -->
        <div class="d-flex align-items-center justify-content-between mb-5">
            <div class="d-flex align-items-center gap-4">
                <a href="/Admin/Users" class="text-decoration-none">
                    <div class="bg-white rounded-circle p-2 shadow-sm hover-lift">
                        <span class="material-icons text-primary" style="font-size: 24px;">arrow_back</span>
                    </div>
                </a>
                <div>
                    <h1 class="h3 fw-bold text-dark mb-1">User Details</h1>
                    <p class="text-muted mb-0">View information about this registered user</p>
                </div>
            </div>

            <!-- Avatar with Initials -->
            <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center text-white fw-black shadow-lg"
                 style="width: 90px; height: 90px; font-size: 36px;">
                @(string.IsNullOrEmpty(Model.UserName) ? "?" : Model.UserName.Substring(0, 1).ToUpper())
            </div>
        </div>

        <!-- Main Card -->
        <div class="bg-white rounded-4 shadow-sm overflow-hidden">
            <div class="p-5">
                <div class="row g-5">

                    <!-- User Info -->
                    <div class="col-lg-8">
                        <h4 class="fw-bold mb-4 d-flex align-items-center gap-2 text-primary">
                            <span class="material-icons">person_outline</span>
                            Account Information
                        </h4>

                        <div class="space-y-4">
                            <div class="d-flex justify-content-between py-3 border-bottom">
                                <div>
                                    <small class="text-muted text-uppercase fw-semibold">User ID</small>
                                    <p class="fw-medium mb-0 text-dark">@Model.Id</p>
                                </div>
                                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="navigator.clipboard.writeText('@Model.Id')">
                                    <span class="material-icons" style="font-size:16px;">content_copy</span>
                                    Copy
                                </button>
                            </div>

                            <div class="py-3 border-bottom">
                                <small class="text-muted text-uppercase fw-semibold">Username</small>
                                <p class="fs-5 fw-bold mb-0">@Model.UserName</p>
                            </div>

                            <div class="py-3 border-bottom">
                                <small class="text-muted text-uppercase fw-semibold">Email Address</small>
                                <p class="fs-5 fw-medium mb-1">
                                    <a href="mailto:@Model.Email" class="text-primary text-decoration-none">@Model.Email</a>
                                </p>
                                <span class="badge rounded-pill px-3 py-2 fw-medium @(Model.EmailConfirmed ? "bg-success text-white" : "bg-warning text-dark")">
                                    @(Model.EmailConfirmed ? "Verified" : "Not Verified")
                                </span>
                            </div>

                            <div class="py-3 border-bottom">
                                <small class="text-muted text-uppercase fw-semibold">Account Status</small>
                                <p class="mb-0">
                                    @if (User.IsInRole("Admin") && Model.Email == User.Identity?.Name)
                                    {
                                        <span class="badge bg-danger text-white rounded-pill px-4 py-2 fs-6">Administrator</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-white rounded-pill px-4 py-2 fs-6">Customer</span>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Actions -->
                    <div class="col-lg-4">
                        <h4 class="fw-bold mb-4 d-flex align-items-center gap-2 text-primary">
                            <span class="material-icons">settings</span>
                            Actions
                        </h4>

                        <div class="d-grid gap-3">
                            <a href="mailto:@Model.Email" class="btn btn-outline-primary rounded-pill px-4 py-3 shadow-sm hover-lift">
                                <span class="material-icons me-2">mail_outline</span>
                                Send Email
                            </a>

                            @if (!(User.IsInRole("Admin") && Model.Email == User.Identity?.Name))
                            {
                                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                    <button type="submit" class="btn btn-outline-danger rounded-pill px-4 py-3 shadow-sm hover-lift w-100">
                                        <span class="material-icons me-2">delete_outline</span>
                                        Delete User
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-secondary rounded-pill px-4 py-3" disabled>
                                    <span class="material-icons me-2">admin_panel_settings</span>
                                    Cannot delete current admin
                                </button>
                            }

                            <a href="/Admin/Users" class="btn btn-light rounded-pill px-4 py-3 shadow-sm hover-lift border">
                                <span class="material-icons me-2">arrow_back</span>
                                Back to Users List
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
   
    </div>
</div>

<!-- Fonts & Icons -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons" />

<style>
    body {
        font-family: 'Inter', sans-serif;
        background: #f9fafb;
    }

    .bg-gray-50 {
        background: #f9fafb;
    }

    .hover-lift {
        transition: all 0.3s ease;
    }

        .hover-lift:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.1) !important;
        }

    .space-y-4 > * + * {
        margin-top: 1rem;
    }

    .py-3 {
        padding-top: 0.75rem !important;
        padding-bottom: 0.75rem !important;
    }

    .border-bottom {
        border-bottom: 1px solid rgba(0,0,0,0.08) !important;
    }
</style>