@model List<GadgetStore.Models.CartItem>
    @{
    ViewData["Title"] = "Shopping Cart";
    var total = Model.Sum(i => i.Product.Price * i.Quantity);
    }

    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>@ViewData["Title"]</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
        <style>
            body {
                font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
                background: linear-gradient(to bottom, #f0faff 0%, #a0e7ff 100%);
                min-height: 100vh;
                background-attachment: fixed;
            }

            .cart-container {
                max-width: 1300px;
            }

            .glass-card {
                background: rgba(255, 255, 255, 0.72);
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
                border-radius: 28px;
                border: 1.5px solid rgba(255, 255, 255, 0.6);
                box-shadow: 0 15px 35px rgba(100, 200, 255, 0.15);
                overflow: hidden;
            }

            .item-row {
                transition: all 0.3s ease;
            }

                .item-row:hover {
                    background: rgba(255, 255, 255, 0.5);
                    transform: translateY(-4px);
                }

            .qty-btn {
                width: 44px;
                height: 44px;
                border-radius: 50%;
                background: white;
                border: 2px solid #00c3ff;
                color: #00aaff;
                font-weight: bold;
                transition: all 0.2s;
            }

                .qty-btn:hover {
                    background: #00c3ff;
                    color: white;
                    transform: scale(1.12);
                }

            .checkout-btn {
                background: linear-gradient(135deg, #00d4ff, #0099cc);
                border: none;
                border-radius: 60px;
                padding: 18px 50px;
                font-size: 1.3rem;
                font-weight: 600;
                color: white;
                box-shadow: 0 12px 30px rgba(0, 200, 255, 0.4);
                transition: all 0.3s ease;
            }

                .checkout-btn:hover {
                    transform: translateY(-6px);
                    box-shadow: 0 20px 40px rgba(0, 200, 255, 0.5);
                }

            .price-highlight {
                color: #0077cc;
                font-weight: 800;
            }

            .remove-btn {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                background: rgba(255, 100, 100, 0.15);
                border: none;
                color: #ff4444;
                transition: all 0.3s;
            }

                .remove-btn:hover {
                    background: #ff4444;
                    color: white;
                    transform: rotate(90deg) scale(1.2);
                }
        </style>
    </head>
    <body class="pt-4">

        <div class="container cart-container">
            <div class="text-center mb-5">
                <h1 class="display-5 fw-bold text-primary">Shopping Cart</h1>
                <p class="text-muted fs-5">@(Model.Any() ? $"You have {Model.Sum(x => x.Quantity)} item{(Model.Sum(x=>x.Quantity)>1?"s":"")} in your cart" : "Your cart is empty")</p>
            </div>

            @if (!Model.Any())
    {
            <div class="text-center py-5">
                <i class="bi bi-cart3 display-1 text-info opacity-50"></i>
                <h3 class="mt-4 text-info">Your cart is waiting for summer gadgets</h3>
                <a href="/Products" class="btn btn-outline-primary btn-lg rounded-pill px-5 mt-3">Continue Shopping</a>
            </div>
    }
    else
    {
            <div class="row g-5 justify-content-center">
                <!-- Items -->
                <div class="col-lg-8">
                    <div class="glass-card p-4">
                        @foreach (var item in Model)
                    {
                        <div class="d-flex align-items-center py-4 item-row border-bottom border-light" data-product-id="@item.Product.Id">
                            <img src="@item.Product.ImageUrl" alt="@item.Product.Name"
                                 class="rounded-4 shadow-sm" style="width: 100px; height: 100px; object-fit: cover;">

                            <div class="ms-4 flex-grow-1">
                                <h5 class="fw-bold text-dark">@item.Product.Name</h5>
                                <small class="text-success">
                                    <i class="bi bi-check-circle-fill"></i> In stock • Fast shipping
                                </small>

                                <div class="d-flex align-items-center mt-3 gap-4">
                                    <div class="d-flex align-items-center">
                                        <button class="btn qty-btn decrease-qty" data-id="@item.Product.Id">–</button>
                                        <input type="text" class="form-control text-center border-0 bg-transparent fw-bold mx-3 qty-input"
                                               style="width: 60px;" value="@item.Quantity" readonly>
                                        <button class="btn qty-btn increase-qty" data-id="@item.Product.Id">+</button>
                                    </div>

                                    <span class="text-muted fs-5">×</span>
                                    <span class="price-highlight fs-4">$@item.Product.Price.ToString("F2")</span>
                                    <span class="text-muted fs-4 ms-2">=</span>
                                    <span class="fw-bold text-info fs-3 subtotal">$@( (item.Product.Price * item.Quantity).ToString("F2") )</span>
                                </div>
                            </div>

                            <form asp-action="RemoveFromCart" method="post" class="ms-3">
                                <input type="hidden" name="productId" value="@item.Product.Id" />
                                <button type="submit" class="btn remove-btn">
                                    <i class="bi bi-x"></i>
                                </button>
                            </form>
                        </div>
                    }
                    </div>
                </div>

                <!-- Summary -->
                <div class="col-lg-4">
                    <div class="glass-card sticky-top" style="top: 20px;">
                        <div class="p-5">
                            <h4 class="fw-bold text-primary mb-4">Order Summary</h4>

                            <div class="d-flex justify-content-between py-3 fs-5">
                                <span>Subtotal</span>
                                <span id="subtotal" class="fw-bold">$@total.ToString("F2")</span>
                            </div>
                            <div class="d-flex justify-content-between py-3 text-success fw-bold">
                                <span>Shipping</span>
                                <span>FREE</span>
                            </div>

                            <hr class="border-light">

                            <div class="d-flex justify-content-between align-items-center mb-5">
                                <h3 class="fw-bold">Total</h3>
                                <h2 id="total" class="text-primary fw-black">$@total.ToString("F2")</h2>
                            </div>

                            <a href="/Checkout" class="btn checkout-btn w-100 text-white">
                                <i class="bi bi-bag-check-fill me-2"></i>
                                Proceed to Checkout
                            </a>

                            <div class="text-center mt-4 text-muted small">
                                <i class="bi bi-shield-lock text-info"></i> Secure • Free returns • Summer vibes guaranteed
                            </div>
                        </div>
                    </div>
                </div>
            </div>
    }
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            document.querySelectorAll('.increase-qty, .decrease-qty').forEach(btn => {
                btn.addEventListener('click', function () {
                    const row = this.closest('[data-product-id]');
                    const qtyInput = row.querySelector('.qty-input');
                    let qty = parseInt(qtyInput.value);
                    const price = parseFloat(row.querySelector('.price-highlight').textContent.replace('$', ''));

                    if (this.classList.contains('increase-qty')) qty++;
                    else if (qty > 1) qty--;

                    qtyInput.value = qty;
                    row.querySelector('.subtotal').textContent = `$${(price * qty).toFixed(2)}`;

                    // Update total
                    let newTotal = 0;
                    document.querySelectorAll('.subtotal').forEach(s => {
                        newTotal += parseFloat(s.textContent.replace('$', ''));
                    });
                    document.getElementById('subtotal').textContent = `$${newTotal.toFixed(2)}`;
                    document.getElementById('total').textContent = `$${newTotal.toFixed(2)}`;
                });
            });
        </script>
    </body>
</html>
