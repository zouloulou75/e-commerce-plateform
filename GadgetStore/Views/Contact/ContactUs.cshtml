@model GadgetStore.Models.ContactUs
@{
    ViewData["Title"] = "Contact Us";
}

<div class="contact-container">
    <div class="contact-card">
        <div class="card-inner">
            <h1 class="title-gradient">Contact Us</h1>

            @if (ViewData["SuccessMessage"] is string successMessage)
            {
                <div class="success-alert" role="alert">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@successMessage</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form asp-action="ContactUs" method="post" class="contact-form needs-validation" novalidate>
                <div class="form-group"><label asp-for="Name" class="form-label-floating">Name</label><input asp-for="Name" class="form-input" placeholder=" " required /><span asp-validation-for="Name" class="text-danger"></span></div>
                <div class="form-group"><label asp-for="Email" class="form-label-floating">Email</label><input asp-for="Email" type="email" class="form-input" placeholder=" " required /><span asp-validation-for="Email" class="text-danger"></span></div>
                <div class="form-group"><label asp-for="Subject" class="form-label-floating">Subject</label><input asp-for="Subject" class="form-input" placeholder=" " required /><span asp-validation-for="Subject" class="text-danger"></span></div>
                <div class="form-group"><label asp-for="Message" class="form-label-floating">Message</label><textarea asp-for="Message" class="form-input textarea" rows="5" placeholder=" " required></textarea><span asp-validation-for="Message" class="text-danger"></span></div>

                <button type="submit" class="btn-submit">
                    <span>Send Message</span>
                    <i class="bi bi-send-fill ms-2"></i>
                </button>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --primary: #4361ee;
            --primary-gradient: linear-gradient(135deg, #4361ee, #3f37c9);
            --bg: #f8f9ff;
        }

        .contact-container {
            min-height: 100vh;
            background: var(--bg);
            background-image: radial-gradient(circle at 10% 20%, rgba(67,97,238,.12) 0%, transparent 20%), radial-gradient(circle at 90% 80%, rgba(63,55,201,.1) 0%, transparent 20%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }

        .contact-card {
            width: 100%;
            max-width: 520px;
            background: rgba(255,255,255,.85);
            backdrop-filter: blur(16px);
            border-radius: 24px;
            box-shadow: 0 15px 35px rgba(0,0,0,.1);
            border: 1px solid rgba(255,255,255,.4);
            overflow: hidden;
        }

        .card-inner {
            padding: 2.5rem 2.8rem; /* Réduit de 3.5rem → 2.5rem */
            background: white;
        }

        .title-gradient {
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 800;
            font-size: 2.6rem; /* Légèrement réduit */
            text-align: center;
            margin-bottom: 1.8rem; /* Réduit le mb-5 → mb-4 équivalent */
        }

        .form-group {
            position: relative;
            margin-bottom: 1.5rem;
        }
        /* Réduit de 2rem → 1.5rem */

        .form-input {
            width: 100%;
            padding: 1rem 1.2rem;
            font-size: 1rem;
            border: 2px solid transparent;
            border-radius: 14px;
            background: #f1f3f9;
            transition: all .3s ease;
        }

            .form-input:focus {
                background: white;
                border-color: var(--primary);
                box-shadow: 0 0 0 4px rgba(67,97,238,.15);
                transform: translateY(-2px);
            }

                .form-input:focus + .form-label-floating,
                .form-input:not(:placeholder-shown) + .form-label-floating {
                    top: -10px;
                    left: 12px;
                    font-size: .82rem;
                    color: var(--primary);
                    background: white;
                    padding: 0 8px;
                }

        .form-label-floating {
            position: absolute;
            top: 1rem;
            left: 1.2rem;
            color: #888;
            pointer-events: none;
            transition: all .3s ease;
            font-weight: 500;
        }

        .textarea {
            resize: none;
        }

        .btn-submit {
            width: 100%;
            padding: 1rem;
            margin-top: .5rem; /* Réduit le mt-4 */
            font-size: 1.05rem;
            font-weight: 600;
            color: white;
            background: var(--primary-gradient);
            border: none;
            border-radius: 14px;
            cursor: pointer;
            transition: all .35s ease;
            box-shadow: 0 8px 25px rgba(67,97,238,.3);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .btn-submit:hover {
                transform: translateY(-3px);
                box-shadow: 0 14px 30px rgba(67,97,238,.4);
            }

        .success-alert {
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(34,197,94,.15);
            color: #166534;
            padding: .9rem 1.3rem;
            border-radius: 14px;
            border-left: 4px solid #22c55e;
            margin-bottom: 1.5rem;
            animation: slideDown .5s ease;
        }

        @@keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-15px);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }

        @@media (max-width: 576px) {
            .card-inner {
                padding: 2rem 1.8rem;
            }

            .title-gradient {
                font-size: 2.3rem;
            }
        }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}