@model GadgetStore.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "TekUp Store - Best Gadgets, Best Prices";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: #f8f9ff;
        }

        /* Hero Section – texte ultra lisible */
        .hero-section {
            background: linear-gradient(90deg, #007bff 0%, #6610f2 100%);
            border-radius: 16px;
            padding: 4rem 2rem;
            text-align: center;
            color: white;
            box-shadow: 0 10px 30px rgba(0,123,255,0.3);
            margin-bottom: 3rem;
        }

            .hero-section h1 {
                font-size: 3.2rem;
                font-weight: 800;
                color: white;
                text-shadow: 0 4px 12px rgba(0,0,0,0.4);
                margin-bottom: 1rem;
            }

            .hero-section p {
                font-size: 1.4rem;
                font-weight: 500;
                color: white !important;
                text-shadow: 0 2px 8px rgba(0,0,0,0.5);
                opacity: 0.95;
                margin-bottom: 2rem;
            }

            .hero-section .btn-light {
                padding: 0.9rem 2.5rem;
                font-size: 1.1rem;
                font-weight: 600;
                border-radius: 50px;
                box-shadow: 0 8px 25px rgba(0,0,0,0.2);
                transition: all 0.3s;
            }

                .hero-section .btn-light:hover {
                    transform: translateY(-4px);
                    box-shadow: 0 15px 35px rgba(0,0,0,0.3);
                }

        /* Cartes produits */
        .image-container {
            height: 220px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f1f5f9;
            padding: 15px;
            border-bottom: 1px solid #e2e8f0;
        }

            .image-container img {
                max-height: 100%;
                max-width: 100%;
                object-fit: contain;
            }

        .card {
            border: none;
            border-radius: 16px;
            overflow: hidden;
            transition: 0.3s;
        }

            .card:hover {
                transform: translateY(-8px);
                box-shadow: 0 15px 35px rgba(0,0,0,0.1);
            }

        /* Why Choose Us – texte bien lisible */
        .about-section {
            background: #ffffff;
            border-radius: 16px;
            padding: 4rem 2rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }

            .about-section h2 {
                color: #007bff;
                font-weight: 700;
                margin-bottom: 1rem;
            }

            .about-section p {
                color: #4b5563 !important;
                font-size: 1.1rem;
            }

            .about-section h5 {
                color: #1f2937;
                font-weight: 600;
                margin-top: 1rem;
            }

            .about-section .text-muted {
                color: #6b7280 !important;
            }
    </style>
</head>
<body>

    <div class="container mt-5">

        <!-- HERO SECTION – TRÈS LISIBILE -->
        <div class="hero-section">
            <h1>Welcome to TekUp Store</h1>
            <p>Explore the latest gadgets and accessories at unbeatable prices!</p>
            <a href="/Products" class="btn btn-light btn-lg">Shop Now</a>
        </div>

        <!-- FEATURED PRODUCTS -->
        <div class="mt-5">
            <h2 class="text-center text-primary fw-bold mb-2" style="color: #007bff;">Featured Products</h2>
            <p class="text-center text-muted mb-5">Discover our best-selling and latest arrivals!</p>

            <div class="row g-4">
                @foreach (var product in Model.FeaturedProducts)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="card shadow-sm h-100">
                            <div class="image-container">
                                <img src="@product.ImageUrl" alt="@product.Name" />
                            </div>
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@product.Name</h5>
                                <p class="card-text text-muted small flex-grow-1">@product.Description</p>
                                <p class="card-text fw-bold text-primary fs-4 mb-3">$@product.Price.ToString("F0")</p>
                                <a href="@Url.Action("Details", "Products", new { id = product.Id })"
                                   class="btn btn-outline-primary mt-auto rounded-pill">View Details</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- WHY CHOOSE US -->
        <div class="about-section text-center mt-5">
            <h2>Why Choose TekUp Store?</h2>
            <p>We offer the best gadgets at unbeatable prices with fast delivery and excellent customer service.</p>

            <div class="row justify-content-center mt-5 g-4">
                <div class="col-md-4">
                    <i class="fas fa-truck text-primary fa-3x mb-3"></i>
                    <h5>Fast Delivery</h5>
                    <p class="text-muted">Get your gadgets delivered quickly and safely to your doorstep.</p>
                </div>
                <div class="col-md-4">
                    <i class="fas fa-shield-alt text-primary fa-3x mb-3"></i>
                    <h5>Secure Payment</h5>
                    <p class="text-muted">Enjoy a seamless and secure checkout process.</p>
                </div>
                <div class="col-md-4">
                    <i class="fas fa-thumbs-up text-primary fa-3x mb-3"></i>
                    <h5>Top Quality</h5>
                    <p class="text-muted">Shop from a wide range of premium and trusted brands.</p>
                </div>
            </div>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>