@model GadgetStore.ViewModels.ProductsViewModel
@{
    ViewData["Title"] = "Shop";
}

<div class="container py-5">
    <!-- Heading -->
    <div class="text-center mb-5">
        <h1 class="fw-bold heading display-4">Best Deals Just For You!</h1>
        <p class="subheading lead mt-3">Colorful gadgets • Low prices • Lightning delivery</p>
    </div>

    <!-- Filter Section -->
    <div class="d-flex justify-content-end mb-5">
        <form method="get" asp-action="Index" class="d-flex gap-3">
            <select name="categoryId" class="form-select category-select shadow-sm">
                <option value="">All Categories</option>
                @foreach (var category in Model.Categories)
                {
                <option value="@category.Id" selected="@(Model.SelectedCategoryId == category.Id ? "selected" : null)">
                    @category.Name
                </option>
                }
            </select>
            <button type="submit" class="btn filter-btn shadow-sm">Apply</button>
        </form>
    </div>

    <!-- Product Grid -->
    <div class="row g-4">
        @foreach (var product in Model.Products)
        {
        <div class="col-6 col-md-4 col-lg-3">
            <div class="product-card">
                <!-- Discount badge -->
                <div class="badge discount-badge">
                    -@((new Random().Next(10,50)))%
                </div>

                <a href="@Url.Action("Details", "Products", new { id = product.Id })" class="text-decoration-none">
                    <div class="product-img">
                        <img src="@product.ImageUrl" alt="@product.Name" />
                    </div>
                    <div class="product-info">
                        <h6 class="product-name">@product.Name</h6>
                        <p class="product-desc text-muted small">@product.Description</p>
                        <div class="price-wrapper mb-3">
                            <span class="price">$@product.Price.ToString("F2")</span>
                            <span class="old-price">$@((product.Price + 20).ToString("F2"))</span>
                        </div>
                        <button class="btn add-to-cart-btn w-100">
                            <span class="me-2">Add to Cart</span>
                        </button>
                    </div>
                </a>
            </div>
        </div>
        }
    </div>
</div>

<style>
    :root {
        /* BLEU EXACTEMENT COMME TA NAVBAR & FOOTER */
        --primary: #007bff; /* Bleu principal */
        --primary-light: #4dabf7;
        --primary-dark: #0056b3;
        --accent: #3399ff; /* Bleu plus vif pour les hovers */
        --bg: #f5f7ff;
        --card-bg: rgba(255, 255, 255, 0.75);
        --glass-border: rgba(0, 123, 255, 0.25);
    }

    body {
        background: var(--bg);
        font-family: 'Poppins', sans-serif;
        min-height: 100vh;
    }

    .heading {
        background: linear-gradient(135deg, var(--primary), var(--accent));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .subheading {
        color: #64748B;
    }

    /* Carte produit – même design, juste en bleu */
    .product-card {
        background: var(--card-bg);
        border-radius: 24px;
        overflow: hidden;
        backdrop-filter: blur(12px);
        border: 1px solid var(--glass-border);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        position: relative;
        height: 100%;
    }

        .product-card:hover {
            transform: translateY(-12px) scale(1.02);
            box-shadow: 0 25px 50px rgba(0, 123, 255, 0.25);
            border-color: var(--primary-light);
        }

    .discount-badge {
        position: absolute;
        top: 14px;
        left: 14px;
        background: var(--accent);
        color: white;
        font-weight: 700;
        font-size: 0.8rem;
        padding: 6px 14px;
        border-radius: 50px;
        z-index: 10;
        box-shadow: 0 4px 15px rgba(51, 153, 255, 0.4);
    }

    .product-img {
        height: 220px;
        background: linear-gradient(135deg, #dbeafe, #bfdbfe);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        transition: 0.4s;
    }

    .product-card:hover .product-img {
        background: linear-gradient(135deg, #93c5fd, #60a5fa);
    }

    .product-img img {
        max-height: 100%;
        object-fit: contain;
        transition: transform 0.5s ease;
    }

    .product-card:hover .product-img img {
        transform: scale(1.12);
    }

    .product-info {
        padding: 20px;
    }

    .product-name {
        font-weight: 600;
        color: #1E293B;
        margin-bottom: 8px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .product-desc {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-bottom: 12px;
    }

    .price-wrapper .price {
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--primary);
    }

    .price-wrapper .old-price {
        color: #94A3B8;
        text-decoration: line-through;
        margin-left: 8px;
        font-size: 0.95rem;
    }

    /* Bouton Add to Cart – maintenant en bleu */
    .add-to-cart-btn {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        border: none;
        border-radius: 16px;
        padding: 14px;
        font-weight: 600;
        color: white;
        font-size: 1rem;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .add-to-cart-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0, 123, 255, 0.4);
            background: linear-gradient(135deg, var(--accent), #1e90ff);
        }

   
    /* Filtre */
    .category-select,
    .filter-btn {
        border-radius: 16px;
        padding: 8px 28px; /* ← augmente ici pour élargir */
        font-weight: 700;
        min-width: 120px; /* optionnel : largeur minimale */
        text-align: center; /* pour que le texte reste centré quand le bouton s'élargit */
    }

    .filter-btn {
        background: var(--primary);
        color: white;
    }

        .filter-btn:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }
</style>